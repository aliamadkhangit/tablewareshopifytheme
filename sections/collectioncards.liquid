{% schema %}
  {

  "name": "Asos 4 2 Slide",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "image",
      "name": "Image slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "image should be 800px x 800px"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
	
		 {
          "type": "image_picker",
          "id": "image2",
          "label": "Image",
          "info": "image should be 300px x 300px"
        },
        {
          "type": "url",
          "id": "link2",
          "label": "Link"
        },
		
		 {
          "type": "image_picker",
          "id": "image3",
          "label": "Image",
          "info": "image should be 300px x 300px"
        },
        {
          "type": "url",
          "id": "link3",
          "label": "Link"
        },
	

       {   "type": "image_picker",
          "id": "image4",
          "label": "Image",
          "info": "image should be 300px x 300px"
        },
        {
          "type": "url",
          "id": "link4",
          "label": "Link"
        }
		











      ]
    }
    
  ],
  "presets": [{
    "name": "Asos 4 2",  
    "category": "Banners",
    "blocks": [
      {
        "type": "image"
      }
    ]
  }]
}
{% endschema %}

{% stylesheet %}


a {
  box-sizing: border-box;
}


.colbanner { 
  float: left; 
  width:  25%; 
  padding: 30px;  
padding-bottom:2px;

}      

.
/* Clearfix (clear floats) */ 
.row::after {
  content: ""; 
  clear: both;
  display: table;
}
@media screen and (max-width: 767px) {
  .colbanner { 
       width: 50%; 
	  padding: 15px; 
  } 

}

.mobilehidden
{
display:block;
}
/* Responsive layout - makes the three columns stack on top of each other instead of next to each other */
@media screen and (max-width: 767px) {
  .mobilehidden {
    display:none;
  }

}


{% endstylesheet %}